# ========================================
# SMART AI IoT - Backend Environment Variables
# ========================================
# INSTRUKSI:
# 1. Copy file ini ke .env
# 2. Isi semua nilai dengan credentials yang benar
# 3. JANGAN commit file .env ke git (sudah ada di .gitignore)
# ========================================

# ========== Application ==========
APP_NAME="SMART AI IoT Backend"
APP_VERSION="3.0.0"
APP_ENV="development"
DEBUG=true

# ========== Server ==========
HOST="0.0.0.0"
PORT=8000

# ========== Database ==========
# SQLite (development)
DATABASE_URL="sqlite+aiosqlite:///./smart_aiot.db"

# PostgreSQL (production) - uncomment jika pakai PostgreSQL
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/smart_aiot_db"

# ========== MQTT Broker (HiveMQ Cloud) ==========
MQTT_BROKER="0899f05ecad5437d93d7fbd8b9b96f70.s1.eu.hivemq.cloud"
MQTT_PORT=8883
MQTT_USERNAME="SMART_AI_IoT"
MQTT_PASSWORD="YOUR_MQTT_PASSWORD_HERE"
MQTT_KEEPALIVE=60

# ========== Google Gemini AI ==========
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.0-flash-exp"

# ========== Security ==========
# Generate dengan: openssl rand -hex 32
SECRET_KEY="your-secret-key-for-jwt-signing-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== CORS ==========
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ========== Redis (optional - untuk production) ==========
# Untuk pending_actions cache dan WebSocket scaling
# REDIS_URL="redis://localhost:6379/0"

# ========== Logging ==========
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"
